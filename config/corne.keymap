#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB         &kp Q  &kp W  &kp F         &kp P       &kp B        &kp J    &kp L  &kp U                &kp Y                 &mt COLON SEMI      &mt TILDE GRAVE
&kp BSPC        &kp A  &kp R  &kp S         &kp T       &kp G        &kp M    &kp N  &kp E                &kp I                 &kp O               &mt DOUBLE_QUOTES SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp D       &kp V        &kp K    &kp H  &mt LESS_THAN COMMA  &mt GREATER_THAN DOT  &mt QUESTION SLASH  &kp RSHFT
                              &kp LEFT_ALT  &lt 1 LWIN  &kp SPACE    &kp RET  &mo 2  &kp ESC
            >;
        };

        layer_1 {
            bindings = <
&trans      &kp LC(Q)  &kp LC(W)  &kp LC(F)     &kp LC(P)  &kp F4    &kp PRINTSCREEN  &kp LC(L)  &trans        &trans     &trans  &kp CAPS
&kp LSHIFT  &kp LC(A)  &kp LC(R)  &kp LC(S)     &kp LC(T)  &trans    &kp DEL          &kp LC(N)  &kp UP_ARROW  &trans     &trans  &trans
&kp LCTRL   &kp LC(Z)  &kp LC(X)  &kp LC(C)     &kp LC(V)  &trans    &trans           &kp LEFT   &kp DOWN      &kp RIGHT  &trans  &trans
                                  &kp LEFT_ALT  &trans     &trans    &trans           &trans     &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &mt EXCLAMATION N1  &mt AT N2  &mt HASH N3                  &mt DOLLAR N4         &mt PERCENT N5    &mt CARET N6        &mt AMPS N7            &mt ASTERISK N8                &mt LEFT_PARENTHESIS N9  &mt RIGHT_PARENTHESIS N0  &kp F11
&trans  &trans              &trans     &mt LEFT_BRACKET LEFT_BRACE  &mt EQUAL PLUS        &kp ASTRK         &kp KP_DIVIDE       &mt UNDER MINUS        &mt RIGHT_BRACKET RIGHT_BRACE  &trans                   &trans                    &trans
&trans  &trans              &trans     &trans                       &kp LEFT_PARENTHESIS  &trans            &mt BACKSLASH PIPE  &kp RIGHT_PARENTHESIS  &trans                         &trans                   &trans                    &trans
                                       &kp LWIN                     &bt BT_CLR_ALL        &trans            &trans              &trans                 &trans
            >;
        };
    };
};
